{{- $profile := promptChoiceOnce . "profile" "Machine profile" (list "personal" "work") -}}
[edit]
  command = "nvim"
[merge]
  command = "nvim"
  args = [
    "-d",
    {{ printf "%q" "{{ .Destination }}" }},
    {{ printf "%q" "{{ .Source }}" }},
    {{ printf "%q" "{{ .Target }}" }},
  ]
[git]
  autoCommit = false
  autoPush = false
{{- if eq .chezmoi.os "windows" }}
{{- /* 指定しないと chezmoi cd が推測したシェルを開く。setup と同じ Windows PowerShell に揃える。 */}}
[cd]
  command = "powershell"
  args = ["-NoLogo"]
{{- end }}
[data]
  profile = {{ $profile | quote }}
