{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-4-6",
  "effortLevel": "medium",
  "language": "japanese",
  "outputStyle": "caveman",
  "autoUpdatesChannel": "stable",
  "respectGitignore": true,
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "Bash(git push *)"
    ],
    "allow": [
      "Bash(chezmoi diff *)",
      "Bash(chezmoi target-path *)",
      "Bash(git branch -vv)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git remote -v)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(jq empty *)",
      "Bash(mise run format)",
      "Bash(mise run lint)",
      "Bash(mise run test)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(/secrets/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(cargo publish*)",
      "Bash(diskutil eraseDisk *)",
      "Bash(gh auth logout)",
      "Bash(gh auth logout *)",
      "Bash(mise run deploy)",
      "Bash(mise run release)",
      "Bash(mkfs *)",
      "Bash(mkfs.* *)",
      "Bash(op item delete *)",
      "Bash(rm -rf /)",
      "Bash(rm -fr /)",
      "Bash(rm -rf /*)",
      "Bash(rm --no-preserve-root *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache/prek/"
      ],
      "denyRead": [
        "~/.env",
        "~/.env.*",
        "~/secrets/**"
      ]
    },
    "network": {
      "allowedDomains": []
    }
  }
}
