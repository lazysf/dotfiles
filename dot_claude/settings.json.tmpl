{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "language": "japanese",
  "outputStyle": "Concise",
  "autoUpdatesChannel": "stable",
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/usage-band"
  },
  "attribution": false,
  "includeGitInstructions": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/signing-agent.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/secrets/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.config/git/start-signing-agent)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude/.credentials.json)",
      "Bash(git push *)",
      "Bash(mkfs *)",
      "Bash(mkfs.* *)",
      "Bash(newfs_* *)",
      "Bash(diskutil *)",
      "Bash(fdisk *)",
      "Bash(gpt *)",
      "Bash(pdisk *)",
      "Bash(apfs_hfs_convert *)",
      "Bash(asr *)",
      "Bash(diskpart *)",
      "Bash(diskpart.exe *)",
      "Bash(format.com *)",
      "Bash(convert.exe *)",
      "Bash(wbadmin *)",
      "Bash(wbadmin.exe *)",
      "Bash(DISKPART *)",
      "Bash(DISKPART.EXE *)",
      "Bash(FORMAT.COM *)",
      "Bash(CONVERT.EXE *)",
      "Bash(WBADMIN *)",
      "Bash(WBADMIN.EXE *)"
    ]
  },
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Agent Git Push: Running `git push` in any form, to any remote or branch, including `--dry-run`, `git -C <dir> push`, `git -c <key>=<value> push`, git aliases, and scripts or other programs that push. The user pushes from their own terminal. On native Windows no sandbox stops an agent push, and the stored Git Credential Manager credential is handed over without a prompt."
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "gh auth status",
      "gh repo view *",
      "gh issue list *",
      "gh issue view *",
      "gh issue create *",
      "gh issue comment *",
      "gh issue edit *",
      "gh issue close *",
      "gh issue reopen *",
      "gh pr list *",
      "gh pr view *",
      "gh pr diff *",
      "gh pr checks *",
      "gh pr status *",
      "gh pr create --head *",
      "gh pr comment *",
      "gh pr edit *",
      "gh pr close *",
      "gh pr reopen *",
      "gh pr ready *",
      "gh pr review *",
      "gh run list *",
      "gh run view *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.cache/prek/"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.local/state/agent-signing",
        "~/.config/git/start-signing-agent"
      ]
    },
    "network": {
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock",
        "~/.local/state/agent-signing/agent.sock"
      ]
    }
  }{{ if eq .chezmoi.os "windows" }},
  "extraKnownMarketplaces": {
    "xlwright": {
      "source": {
        "source": "git",
        "url": "https://github.com/lazysf/xlwright.git"
      }
    }
  },
  "enabledPlugins": {
    "xlwright@xlwright": true
  }{{ end }}
}
