{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "effortLevel": "medium",
  "language": "japanese",
  "outputStyle": "caveman",
  "autoUpdatesChannel": "stable",
  "autoMemoryEnabled": false,
  "respectGitignore": true,
  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Agent(quality-reviewer)",
      "Agent(researcher)",
      "Agent(security-reviewer)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm --no-preserve-root *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(mkfs *)",
      "Bash(mkfs.* *)",
      "Bash(diskutil eraseDisk *)",
      "Bash(gh auth logout)",
      "Bash(gh auth logout *)",
      "Bash(op item delete *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(git remote set-url *)",
      "Bash(git remote add *)"
    ]
  },
  "sandbox": {
    "enabled": {{ if eq .chezmoi.os "windows" }}false{{ else }}true{{ end }},
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "filesystem": {
      "allowWrite": [
        "~/.cache/prek/"
      ],
      "denyRead": [
        "~/.env",
        "~/.env.*",
        "~/.aws",
        "~/.config/gh",
        "~/.docker/config.json",
        "~/.gnupg",
        "~/.kube",
        "~/.netrc",
        "~/.npmrc",
        "~/.pypirc",
        "~/.ssh",
        "~/secrets"
      ],
      "allowRead": [
        "~/.ssh/known_hosts",
        "~/.ssh/config"
      ],
      "denyWrite": [
        "~/.env",
        "~/.env.*",
        "~/.aws",
        "~/.config/gh",
        "~/.docker/config.json",
        "~/.gnupg",
        "~/.kube",
        "~/.netrc",
        "~/.npmrc",
        "~/.pypirc",
        "~/.ssh",
        "~/secrets"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com"
      ],
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ]
    }
  }
}
