{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5",
  "effortLevel": "high",
  "language": "japanese",
  "outputStyle": "caveman",
  "autoUpdatesChannel": "stable",
  "autoMemoryEnabled": false,
  "respectGitignore": true,
  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Agent(quality-reviewer)",
      "Agent(researcher)",
      "Agent(security-reviewer)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm --no-preserve-root *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(mkfs *)",
      "Bash(mkfs.* *)",
      "Bash(diskutil eraseDisk *)",
      "Bash(gh auth logout)",
      "Bash(gh auth logout *)",
      "Bash(op item delete *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(git remote set-url *)",
      "Bash(git remote add *)",
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(pnpm publish)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish)",
      "Bash(yarn publish *)",
      "Bash(yarn npm publish)",
      "Bash(yarn npm publish *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(iwr *)",
      "PowerShell(irm *)",
      "PowerShell(curl.exe *)",
      "PowerShell(wget.exe *)",
      "PowerShell(gh auth logout)",
      "PowerShell(gh auth logout *)",
      "PowerShell(op item delete *)",
      "PowerShell(git remote set-url *)",
      "PowerShell(git remote add *)",
      "PowerShell(Format-Volume *)",
      "PowerShell(Clear-Disk *)",
      "PowerShell(Initialize-Disk *)",
      "PowerShell(diskpart)",
      "PowerShell(diskpart *)",
      "PowerShell(format *)",
      "PowerShell(Remove-Item -Recurse -Force C:\\*)",
      "PowerShell(Remove-Item -Recurse -Force $HOME*)",
      "PowerShell(Remove-Item -Recurse -Force $env:USERPROFILE*)"
    ]
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Organization: individual developer, no company or team.",
      "Primary use of Claude Code: maintaining a personal dotfiles repository and its Codex / Claude Code agent harness on macOS.",
      "Repository visibility: public. The working repository is github.com/lazysf/dotfiles, a public personal dotfiles repository whose own subject matter is shell, editor, chezmoi, Codex, and Claude Code configuration.",
      "Source control: GitHub, github.com/lazysf. No other source-control org is trusted.",
      "Cloud provider(s): none.",
      "CI/CD deploy targets: none. This repository has no deploy pipeline; changes land by commit and push only.",
      "Secrets management: 1Password, via the op CLI and its SSH agent socket.",
      "Org-specific CLIs: chezmoi for dotfiles apply, op for 1Password, gh for GitHub, uv for Python, prek for pre-commit hooks.",
      "Internal package registry: none. Public npm and PyPI are the intended registries.",
      "Network posture: sandboxed Bash reaches only github.com, registry.npmjs.org, pypi.org, and files.pythonhosted.org. Any other host is judged case by case, not pre-approved.",
      "Sensitive data locations & audiences: ~/.ssh, ~/.aws, ~/.config/gh, ~/.gnupg, ~/.kube, ~/.docker/config.json, ~/.netrc, ~/.npmrc, ~/.pypirc, and any .env file. These are never an acceptable source for repository content, commit contents, pushes, or any outbound message. This repository being a dotfiles repository does not clear them."
    ]
  },
  "sandbox": {
    "enabled": {{ if eq .chezmoi.os "windows" }}false{{ else }}true{{ end }},
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "~/.cache/prek/"
      ],
      "denyRead": [
        "~/.env",
        "~/.env.*",
        "~/.aws",
        "~/.config/gh",
        "~/.docker/config.json",
        "~/.gnupg",
        "~/.kube",
        "~/.netrc",
        "~/.npmrc",
        "~/.pypirc",
        "~/.ssh",
        "~/secrets"
      ],
      "allowRead": [
        "~/.ssh/known_hosts",
        "~/.ssh/config"
      ],
      "denyWrite": [
        "~/.env",
        "~/.env.*",
        "~/.aws",
        "~/.config/gh",
        "~/.docker/config.json",
        "~/.gnupg",
        "~/.kube",
        "~/.netrc",
        "~/.npmrc",
        "~/.pypirc",
        "~/.ssh",
        "~/secrets"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ],
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ]
    }
  }
}
