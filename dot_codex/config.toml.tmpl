# 通常作業の既定値。作業ごとのモデルと effort は client で上書きする。
model = "gpt-6.1-sol"
model_reasoning_effort = "medium"
approval_policy = "on-request"
approvals_reviewer = "auto_review"
default_permissions = "workspace"

[features]
memories = false
network_proxy = true

[permissions.protected]
description = "Read-only review with credential stores denied"
extends = ":read-only"

[permissions.protected.filesystem]
"~/.ssh" = "deny"
"~/.aws" = "deny"
"~/.config/gh" = "deny"
"~/.gnupg" = "deny"
"~/.kube" = "deny"
"~/.docker/config.json" = "deny"
"~/.netrc" = "deny"
"~/.npmrc" = "deny"
"~/.pypirc" = "deny"
"~/.env" = "deny"
"~/.env.*" = "deny"
{{- if eq .chezmoi.os "windows" }}
"~/**/.env" = "deny"
"~/**/.env.*" = "deny"
"~/**/secrets" = "deny"
{{- else }}
"/**/.env" = "deny"
"/**/.env.*" = "deny"
"/**/secrets" = "deny"
{{- end }}

[permissions.protected.filesystem.":workspace_roots"]
"**/.env" = "deny"
"**/.env.*" = "deny"
"**/secrets" = "deny"

[permissions.protected.network]
enabled = false

[permissions.workspace]
description = "Workspace edits with credential stores denied"
extends = "protected"

[permissions.workspace.filesystem]
":tmpdir" = "write"
":slash_tmp" = "write"
"~/.cache/prek" = "write"

[permissions.workspace.filesystem.":workspace_roots"]
"." = "write"
# stage / commit に必要な Git metadata への書き込みを明示する。
".git" = "write"

[permissions.workspace.network]
enabled = true
# 外部の domain は許可せず、署名用 socket だけを許可する。
domains = {}

[permissions.workspace.network.unix_sockets]
{{ printf "%s/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" .chezmoi.homeDir | toJson }} = "allow"
