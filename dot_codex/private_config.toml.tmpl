model = "gpt-5.4"
model_reasoning_effort = "high"
approval_policy = "on-request"
sandbox_mode = "workspace-write"
web_search = "live"

[agents]
max_threads = 6
max_depth = 1

{{ if eq .chezmoi.os "windows" -}}
[sandbox_workspace_write]
network_access = false

{{ end -}}
[features]
shell_snapshot = true
multi_agent = true

[marketplaces.openai-bundled]
last_updated = "2026-04-20T11:26:15Z"
source_type = "local"
source = "{{ joinPath .chezmoi.homeDir ".codex" ".tmp" "bundled-marketplaces" "openai-bundled" }}"

[projects."{{ .chezmoi.sourceDir }}"]
trust_level = "trusted"
