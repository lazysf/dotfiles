{{- $configPath := joinPath .chezmoi.homeDir ".codex" "config.toml" -}}
{{- $current := dict -}}
{{- if lstat $configPath -}}
  {{- $current = (include $configPath | fromToml) -}}
{{- end -}}

{{- $hasPlugins := hasKey $current "plugins" -}}
{{- $hasMarketplaces := hasKey $current "marketplaces" -}}
{{- $preservedProjects := dict -}}
{{- $preservedPlugins := dict -}}
{{- $preservedMarketplaces := dict -}}
{{- if hasKey $current "projects" -}}
  {{- $preservedProjects = get $current "projects" -}}
{{- end -}}
{{- if hasKey $current "plugins" -}}
  {{- $preservedPlugins = get $current "plugins" -}}
{{- end -}}
{{- if hasKey $current "marketplaces" -}}
  {{- $preservedMarketplaces = get $current "marketplaces" -}}
{{- end -}}

{{- $managedProjects := dict .chezmoi.sourceDir (dict "trust_level" "trusted") -}}
{{- $finalProjects := mergeOverwrite $preservedProjects $managedProjects -}}
model = "gpt-5.4"
model_reasoning_effort = "high"
approval_policy = "on-request"
sandbox_mode = "workspace-write"
web_search = "live"

[agents]
max_threads = 6
max_depth = 1

{{ if eq .chezmoi.os "windows" -}}
[sandbox_workspace_write]
network_access = false

{{ end -}}
[tui]
notifications = ["agent-turn-complete", "approval-requested"]
notification_method = "bel"

[features]
shell_snapshot = true
multi_agent = true
{{ printf "\n%s" (dict "projects" $finalProjects | toToml | trim) -}}
{{- if $hasPlugins }}{{ printf "\n\n%s" (dict "plugins" $preservedPlugins | toToml | trim) -}}{{ end }}
{{- if $hasMarketplaces }}{{ printf "\n\n%s" (dict "marketplaces" $preservedMarketplaces | toToml | trim) -}}{{ end }}
{{- if eq .chezmoi.os "windows" }}

[windows]
sandbox = "elevated"
{{ end }}
