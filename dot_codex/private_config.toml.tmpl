{{- $configPath := joinPath .chezmoi.homeDir ".codex" "config.toml" -}}
{{- $current := dict -}}
{{- if lstat $configPath -}}
  {{- $current = (include $configPath | fromToml) -}}
{{- end -}}

{{- $preservedProjects := dict -}}
{{- if hasKey $current "projects" -}}
  {{- $preservedProjects = get $current "projects" -}}
{{- end -}}
{{- $managedPlugins := dict -}}
{{- $managedMarketplaces := dict -}}

{{- $managedProjects := dict .chezmoi.sourceDir (dict "trust_level" "trusted") -}}
{{- $finalProjects := mergeOverwrite $preservedProjects $managedProjects -}}
{{- $projectsToml := (dict "projects" $finalProjects | toToml | trim) -}}
{{- $projectsToml = regexReplaceAll "(?m)^ +" $projectsToml "" -}}
{{- $pluginsToml := (dict "plugins" $managedPlugins | toToml | trim) -}}
{{- $pluginsToml = regexReplaceAll "(?m)^ +" $pluginsToml "" -}}
{{- $marketplacesToml := (dict "marketplaces" $managedMarketplaces | toToml | trim) -}}
{{- $marketplacesToml = regexReplaceAll "(?m)^ +" $marketplacesToml "" -}}
model = "gpt-5.4"
model_reasoning_effort = "high"
approval_policy = "on-request"
sandbox_mode = "workspace-write"
web_search = "live"

[agents]
max_threads = 6
max_depth = 1

{{ if eq .chezmoi.os "windows" -}}
[sandbox_workspace_write]
network_access = false

{{ end -}}
[tui]
notifications = ["agent-turn-complete", "approval-requested"]
notification_method = "bel"

[features]
shell_snapshot = true
multi_agent = true
codex_hooks = false
{{ printf "\n%s" $projectsToml -}}
{{- if gt (len $managedPlugins) 0 }}{{ printf "\n\n%s" $pluginsToml -}}{{ end }}
{{- if gt (len $managedMarketplaces) 0 }}{{ printf "\n\n%s" $marketplacesToml -}}{{ end }}
