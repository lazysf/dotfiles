{{- $codexConfigPath := joinPath .chezmoi.homeDir ".codex" "config.toml" -}}
{{- $codexConfig := dict -}}
{{- if stat $codexConfigPath -}}
{{- $codexConfig = include $codexConfigPath | fromToml -}}
{{- end -}}
{{- $codexProjects := dig "projects" (dict) $codexConfig -}}
model = "gpt-5.5"
model_reasoning_effort = "medium"
approval_policy = "on-request"
approvals_reviewer = "auto_review"
sandbox_mode = "workspace-write"
web_search = "live"
{{ if eq .chezmoi.os "darwin" }}
notify = ["{{ joinPath .chezmoi.homeDir ".codex" "computer-use" "Codex Computer Use.app" "Contents" "SharedSupport" "SkyComputerUseClient.app" "Contents" "MacOS" "SkyComputerUseClient" | replace "\\" "/" }}", "turn-ended"]
{{ end }}
[agents]
max_threads = 6
max_depth = 1

[sandbox_workspace_write]
network_access = false

[features]
shell_snapshot = true
multi_agent = true
# UnderDevelopment flag: request_user_input tool を default mode でも有効化する (openai/codex#12694)
default_mode_request_user_input = true

[projects."{{ .chezmoi.sourceDir }}"]
trust_level = "trusted"
{{- /* Keep only trust_level for target-only projects so nested tables cannot escape [projects.<path>] scope. */ -}}
{{- range $projectPath, $projectConfig := $codexProjects }}
{{- $trustLevel := dig "trust_level" "" $projectConfig -}}
{{- if and (ne $projectPath $.chezmoi.sourceDir) $trustLevel }}

[projects.{{ $projectPath | quote }}]
{{ dict "trust_level" $trustLevel | toToml | trimSuffix "\n" }}
{{- end }}
{{- end }}

[marketplaces.openai-bundled]
last_updated = "{{ dig "marketplaces" "openai-bundled" "last_updated" "2026-05-13T02:02:40Z" $codexConfig }}"
source_type = "local"
source = "{{ joinPath .chezmoi.homeDir ".codex" ".tmp" "bundled-marketplaces" "openai-bundled" | replace "\\" "/" }}"

[marketplaces.openai-primary-runtime]
last_updated = "{{ dig "marketplaces" "openai-primary-runtime" "last_updated" "2026-05-11T00:23:51Z" $codexConfig }}"
source_type = "local"
source = "{{ joinPath .chezmoi.homeDir ".cache" "codex-runtimes" "codex-primary-runtime" "plugins" "openai-primary-runtime" | replace "\\" "/" }}"

[plugins."computer-use@openai-bundled"]
enabled = true

[plugins."documents@openai-primary-runtime"]
enabled = true

[plugins."spreadsheets@openai-primary-runtime"]
enabled = true

[plugins."presentations@openai-primary-runtime"]
enabled = true

[plugins."browser@openai-bundled"]
enabled = true

{{ if eq .chezmoi.os "windows" -}}
[windows]
sandbox = "elevated"
{{ end -}}
