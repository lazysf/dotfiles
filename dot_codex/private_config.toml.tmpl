{{- $configPath := joinPath .chezmoi.homeDir ".codex" "config.toml" -}}
{{- $current := dict -}}
{{- if lstat $configPath -}}
  {{- $current = (include $configPath | fromToml) -}}
{{- end -}}

{{- $hasPlugins := hasKey $current "plugins" -}}
{{- $hasMarketplaces := hasKey $current "marketplaces" -}}
{{- $preservedProjects := dict -}}
{{- $preservedPlugins := dict -}}
{{- $preservedMarketplaces := dict -}}
{{- if hasKey $current "projects" -}}
  {{- $preservedProjects = get $current "projects" -}}
{{- end -}}
{{- if hasKey $current "plugins" -}}
  {{- $preservedPlugins = get $current "plugins" -}}
{{- end -}}
{{- if hasKey $current "marketplaces" -}}
  {{- $preservedMarketplaces = get $current "marketplaces" -}}
{{- end -}}

{{- $managedProjects := dict .chezmoi.sourceDir (dict "trust_level" "trusted") -}}
{{- $finalProjects := mergeOverwrite $preservedProjects $managedProjects -}}

{{- $final := dict
  "model" "gpt-5.4"
  "model_reasoning_effort" "high"
  "approval_policy" "on-request"
  "sandbox_mode" "workspace-write"
  "web_search" "live"
  "tui" (dict
    "notifications" (list "agent-turn-complete" "approval-requested")
    "notification_method" "bel"
  )
  "features" (dict
    "shell_snapshot" true
    "multi_agent" true
  )
  "agents" (dict
    "max_threads" 6
    "max_depth" 1
  )
  "projects" $finalProjects
-}}

{{- if eq .chezmoi.os "windows" -}}
  {{- $final = mergeOverwrite $final (dict
    "windows" (dict "sandbox" "elevated")
    "sandbox_workspace_write" (dict "network_access" false)
  ) -}}
{{- end -}}

{{- if $hasPlugins -}}
  {{- $final = mergeOverwrite $final (dict "plugins" $preservedPlugins) -}}
{{- end -}}
{{- if $hasMarketplaces -}}
  {{- $final = mergeOverwrite $final (dict "marketplaces" $preservedMarketplaces) -}}
{{- end -}}

{{ $final | toToml -}}
