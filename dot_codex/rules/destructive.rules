# sandbox 外へ出すコマンドの禁止。shell や script の全挙動は覆わない。
commands = [
    "mkfs", "mkfs.apfs", "mkfs.ext2", "mkfs.ext3", "mkfs.ext4",
    "mkfs.fat", "mkfs.hfs", "mkfs.vfat", "mkfs.xfs",
    "newfs_apfs", "newfs_exfat", "newfs_hfs", "newfs_msdos", "newfs_udf",
    "diskutil", "fdisk", "gpt", "pdisk", "apfs_hfs_convert", "asr",
]

command_paths = commands + [
    directory + command
    for directory in ["/bin/", "/sbin/", "/usr/bin/", "/usr/sbin/"]
    for command in commands
]

prefix_rule(
    pattern = [command_paths],
    decision = "forbidden",
    justification = "ディスクの初期化・消去は人が terminal で行う。",
    match = ["diskutil eraseDisk APFS example /dev/example", "mkfs.ext4 /dev/example", "/usr/sbin/diskutil list"],
    not_match = ["git status", "df -h"],
)

windows_disk_commands = [
    "diskpart", "diskpart.exe", "format.com", "convert.exe", "wbadmin", "wbadmin.exe",
    "DISKPART", "DISKPART.EXE", "FORMAT.COM", "CONVERT.EXE", "WBADMIN", "WBADMIN.EXE",
]

prefix_rule(
    pattern = [windows_disk_commands],
    decision = "forbidden",
    justification = "Windows のディスク・バックアップ操作は人が terminal で行う。",
    match = windows_disk_commands,
    not_match = ["convert", "git status"],
)

prefix_rule(
    pattern = [["git", "git.exe"], "push"],
    decision = "forbidden",
    justification = "push はユーザーが手元の terminal で行う。",
    match = ["git push", "git.exe push origin main"],
    not_match = ["git status", "git.exe fetch"],
)
