prefix_rule(
  pattern = ["git", "add"],
  decision = "allow",
  justification = "合意済みの対象に限ったパス指定の git add を許可する。",
  match = [
    "git add README.md",
    "git add path/to/file",
    "git add dir/file1 dir/file2",
  ],
  not_match = [
    "git commit -m \"chore: update\"",
    "git status",
  ],
)
