# This intentionally overlaps with git-add-allow.rules.
# Codex applies the most restrictive decision when multiple rules match.
prefix_rule(
  pattern = ["git", "add", [".", "-A", "--all", "-u", "--update", "-p", "--patch"]],
  decision = "prompt",
  justification = "広範囲の staging や対話的 staging は、意図しない対象を含めやすいため都度確認する。",
  match = [
    "git add .",
    "git add -A",
    "git add --all",
    "git add -u",
    "git add --update",
    "git add -p",
    "git add --patch",
  ],
  not_match = [
    "git add README.md",
    "git add path/to/file",
  ],
)
