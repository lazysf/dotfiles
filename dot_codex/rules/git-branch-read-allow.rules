prefix_rule(
  pattern = ["git", "branch"],
  decision = "allow",
  justification = "push 先判定に必要な読み取り専用の git branch 確認のみ許可する。",
  match = [
    "git branch -vv",
    "git branch --show-current",
  ],
  not_match = [
    "git branch -d feature/foo",
    "git branch -D feature/foo",
    "git branch -m old new",
    "git branch --unset-upstream",
  ],
)
