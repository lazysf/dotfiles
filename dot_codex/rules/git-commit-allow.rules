prefix_rule(
  pattern = ["git", "commit", ["-m", "-F"]],
  decision = "allow",
  justification = "通常の git-commit フローで使う、`-m` / `-F` の非対話コミットのみを許可する。",
  match = [
    "git commit -m \"chore: update\"",
    "git commit -m \"feat: add automation-safe flow\" -m \"Why: ...\"",
    "git commit -F /tmp/git-commit-message.txt",
  ],
  not_match = [
    "git commit",
    "git commit --interactive",
    "git commit --amend",
    "git commit --edit",
    "git commit -e",
    "git commit -c HEAD",
    "git commit --reuse-message HEAD --edit",
    "git commit --patch",
    "git commit -p",
  ],
)
