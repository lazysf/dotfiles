prefix_rule(
  pattern = ["git", ["diff", "log", "status"]],
  decision = "allow",
  justification = "読み取り専用で安全な git 操作（diff/log/status）のみ許可する。",
  match = [
    "git diff",
    "git diff --cached",
    "git log",
    "git log -1 --oneline",
    "git status",
  ],
  not_match = [
    "git checkout -b feature/foo",
    "git rebase -i HEAD~3",
    "git branch -a",
  ],
)
