# This intentionally overlaps with git-restore-staged-allow.rules.
# Codex applies the most restrictive decision when multiple rules match.
prefix_rule(
  pattern = ["git", "restore", "--staged", [".", "--worktree"]],
  decision = "prompt",
  justification = "広範囲のステージ解除や worktree 変更を伴う restore は影響範囲を誤りやすいため都度確認する。",
  match = [
    "git restore --staged .",
    "git restore --staged --worktree README.md",
  ],
  not_match = [
    "git restore --staged README.md",
    "git restore README.md",
  ],
)
