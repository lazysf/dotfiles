prefix_rule(
  pattern = ["git", "restore", "--staged"],
  decision = "allow",
  justification = "合意済みの対象に限ったステージ解除のみを安全な git restore 操作として許可する。",
  match = [
    "git restore --staged README.md",
    "git restore --staged path/to/file",
  ],
  not_match = [
    "git restore README.md",
    "git restore .",
  ],
)
