prefix_rule(
  pattern = ["rm", "--no-preserve-root", ["-rf", "-fr"], "/"],
  decision = "forbidden",
  justification = "ルートファイルシステム削除は Codex から絶対に実行しない。",
  match = [
    "rm --no-preserve-root -rf /",
    "rm --no-preserve-root -fr /",
  ],
  not_match = [
    "rm --no-preserve-root -rf /tmp/example",
    "rm --no-preserve-root -fr /tmp/example",
  ],
)
