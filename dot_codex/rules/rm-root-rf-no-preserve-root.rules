prefix_rule(
  pattern = ["rm", ["-rf", "-fr"], "--no-preserve-root", "/"],
  decision = "forbidden",
  justification = "ルートファイルシステム削除は Codex から絶対に実行しない。",
  match = [
    "rm -rf --no-preserve-root /",
    "rm -fr --no-preserve-root /",
  ],
  not_match = [
    "rm -rf --no-preserve-root /tmp/example",
    "rm -fr --no-preserve-root /tmp/example",
  ],
)
