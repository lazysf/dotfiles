[include]
  path = ~/.config/git/config.local
{{ if eq .chezmoi.os "darwin" -}}
{{ if ne (lookPath "op") "" -}}
{{/* 値は使わない。op が 1Password へ到達できない時に、署名設定が落ちた config を静かに書き出さず、
     ここで展開を失敗させるための呼び出し。 */ -}}
{{ $opWhoami := output "op" "whoami" -}}
[user]
  # name / email は commit に載る公開値だが、アカウントを作り直した時に repo の差し替えを
  # 要らなくするため 1Password を正本にする。email は allowed_signers.tmpl の principal と同じ参照
  name  = {{ onepasswordRead "op://Personal/GitHub/username" | quote }}
  email = {{ onepasswordRead "op://Personal/GitHub/noreply" | quote }}
  signingkey = {{ onepasswordRead "op://Personal/GitHub Sign Key/public key"| quote }}
[gpg "ssh"]
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
  allowedSignersFile = ~/.config/git/allowed_signers
[gpg]
  format = ssh
[commit]
  gpgsign = true
{{ end -}}
{{ end -}}
[ghq]
  root = ~/projects
[init]
  defaultBranch = main
[fetch]
  prune = true
[status]
  showUntrackedFiles = all
[core]
  autocrlf = input
  filemode = false
  ignorecase = false
  quotepath = false
[merge]
  conflictStyle = diff3
